# Frontend production build config.
#
# Copy this file to `frontend/.env.production` and set VITE_API_URL to your
# deployed backend's PUBLIC URL (NOT localhost). Vite bakes this value into the
# bundle at `npm run build`, so the deployed dashboard calls the real backend
# instead of http://localhost:8000 (which only exists on a developer machine and
# leaves visitors stuck on "Fidel is loading market telemetry...").
#
# Railway: backend service -> Settings -> Networking -> Public Domain.
# Use the https:// URL with no trailing slash. The dashboard derives the
# WebSocket URL automatically (https -> wss).

VITE_API_URL=https://your-fidel-backend.up.railway.app
