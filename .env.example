# --- Market data (CMC Agent Hub). Leave blank to use the real public price
#     fallback (Binance spot) so the agent still trades on honest live prices. ---
CMC_API_KEY=
CMC_MCP_COMMAND=

# --- Execution / wallet. All four below are required for LIVE on-chain trades.
#     With any missing, Fidel runs in honest PAPER mode (simulated fills). ---
TRUST_WALLET_PRIVATE_KEY=
AGENT_WALLET_ADDRESS=
TWAK_COMMAND=twak
PANCAKESWAP_V3_ROUTER=
PANCAKESWAP_PERPS_CONTRACT=
BSC_RPC_URL=https://bsc-dataseed.binance.org

# --- LLM reasoning (optional; deterministic template used if unset) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- BNB AI Agent SDK (bnbagent, installed via requirements). ---
# BNB_AGENT_SDK_COMMAND / CMC_MCP_COMMAND must be a real executable on PATH or
# left blank. Never use an inline "VAR=value" prefix (e.g. "=bnbaent") - it is
# rejected before reaching a shell so a typo cannot crash the agent or deploy.
BNB_AGENT_SDK_ENABLED=true
BNB_AGENT_SDK_COMMAND=
BNB_NETWORK=bsc

# --- Competition ---
COMPETITION_CONTRACT_ADDRESS=0x212c61b9b72c95d95bf29cf032f5e5635629aed5

# --- Risk gates ---
MAX_DRAWDOWN_PCT=25
DAILY_LOSS_LIMIT_PCT=5
MAX_POSITION_PCT=2
MIN_SIGNAL_CONFIDENCE=70
MIN_RISK_REWARD=1.8
TRADE_INTERVAL_SECONDS=60

# --- Data / performance (keep Railway light) ---
DATA_FALLBACK_ENABLED=true
PUBLIC_PRICE_FEED=true
SCAN_CONCURRENCY=6
# SCAN_UNIVERSE=ETH,XRP,CAKE,DOGE,LINK   # optional: override the focused universe

# --- Reliability ---
AUTO_START=true
STRICT_LIVE_TOKEN_CONTRACTS=true
AUTONOMOUS_LIVE=true

# --- Paths ---
ELIGIBLE_TOKEN_REGISTRY_PATH=config/eligible_tokens.json
INITIAL_PORTFOLIO_USDT=1000
DATABASE_PATH=data/fidel.sqlite3
CSV_PATH=data/fidel_trades.csv
STATE_PATH=data/agent_state.json

# --- Frontend ---
VITE_API_URL=http://localhost:8000
